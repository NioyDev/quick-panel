[Unit]
Description=Quick Panel - Panel premium para XFCE
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=%h/.Xauthority
ExecStartPre=/bin/bash -c 'pgrep -x picom || picom -b'
ExecStart=/usr/bin/python3 %h/.local/bin/quick-panel.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
