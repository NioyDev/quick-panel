[Unit]
Description=Quick Notifications - Sistema de notificaciones para Quick Panel
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0.0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python3 %h/.local/bin/quick-notifications.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
